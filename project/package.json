{
  "name": "ai-learning-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/server.ts",
    "dev:chatbot": "cd chatbot && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "dev:chatbot:unix": "cd chatbot && source .venv/bin/activate && python -m uvicorn main:app --reload --port 8000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/server.ts",
    "server": "tsx server/server.ts",
    "lint": "eslint .",
    "clean": "rimraf dist node_modules/.cache",
    "setup": "npm install && cd chatbot && pip install -r requirements.txt",
    "setup:full": "npm run setup:node && npm run setup:python",
    "setup:node": "npm install",
    "setup:python": "cd chatbot && python -m venv .venv && .venv\\Scripts\\activate && pip install -r requirements.txt && python -m spacy download en_core_web_sm",
    "setup:python:unix": "cd chatbot && python3 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt && python -m spacy download en_core_web_sm",
    "start:all": "scripts\\start_all.bat",
    "start:all:unix": "scripts/start_all.sh",
    "docs": "echo Opening project documentation... && start docs\\project-structure.md",
    "postinstall": "echo Run 'npm run setup:python' to complete the Python setup"
  },
  "dependencies": {
    "@types/moment": "^2.13.0",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "moment": "^2.30.1",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.3",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.7",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
